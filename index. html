    <script>
        // Secure Instantiation of production token engine link
        const stripe = Stripe('pk_live_51UJECdKEqJZY3CRQWWFJx3Lq7sMfQB36SGFHN2ILIl45kyjv3RHv3jEPck2mXtcov6e2ywolyamfdscCr0E2ftwr00SCrvrDVs');

        function toggleModal(id) {
            document.getElementById(id).classList.toggle('hidden');
        }

        async function handleAuth(e) {
            e.preventDefault();
            const email = document.getElementById('auth-email').value;
            try {
                const res = await fetch('/v1/auth/session', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ email: email })
                });
                const userSession = await res.json();
                
                localStorage.setItem('crarrar_user', email);
                localStorage.setItem('crarrar_tier', userSession.tier);
                updateUIState(email, userSession.tier);
                toggleModal('auth-modal');
            } catch (err) {
                alert("Session handshaking error.");
            }
        }

        function updateUIState(email, tier) {
            if(!email) return;
            document.getElementById('auth-btn').innerText = `ID: ${email.split('@')[0]}`;
            const statusText = document.getElementById('system-status-text');
            const portalBtn = document.getElementById('portal-btn');
            const upgradeBtn = document.getElementById('upgrade-btn');

            if(tier === 'PRO_TIER') {
                statusText.innerText = "Compute matrix optimized. Pro Account Active: Token generation running unthrottled.";
                statusText.className = "text-sm text-amber-400 font-semibold";
                portalBtn.classList.remove('hidden');
                upgradeBtn.innerText = "Active Subscription";
                upgradeBtn.className = "w-full mt-6 bg-emerald-900/40 border border-emerald-500/30 text-emerald-400 text-xs font-bold py-2 rounded-lg cursor-not-allowed";
                upgradeBtn.disabled = true;
            } else {
                statusText.innerText = "Session validated. Free tier rate limits strictly applied.";
                statusText.className = "text-sm text-slate-400";
                portalBtn.classList.add('hidden');
            }
        }

