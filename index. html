            <form onsubmit="handleAuth(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-mono text-slate-400 mb-1">Email Endpoint Address</label>
                    <input type="email" id="auth-email" required placeholder="name@domain.com" class="w-full bg-[#0b0f19] border border-slate-800 rounded-lg px-3 py-2 text-sm text-slate-200 outline-none focus:border-rose-500">
