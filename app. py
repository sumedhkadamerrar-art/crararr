@app.route('/v1/billing/webhook', methods=['POST'])
def stripe_webhook():
    payload = request.data
    sig_header = request.headers.get('Stripe-Signature')
    try:
        event = stripe.Webhook.construct_event(payload, sig_header, STRIPE_WEBHOOK_SECRET)
    except Exception:
        return Response(status=400)

    if event['type'] == 'checkout.session.completed':
        session = event['data']['object']
        customer_email = session.get('customer_details', {}).get('email')
        stripe_cust_id = session.get('customer')
        stripe_sub_id = session.get('subscription')

        with sqlite3.connect(DATABASE_FILE) as conn:
            conn.execute("""
                UPDATE system_operators 
                SET stripe_customer_id = ?, stripe_subscription_id = ?, tier_access = 'PRO_TIER', daily_usage_count = 0 
                WHERE email = ?
            """, (stripe_cust_id, stripe_sub_id, customer_email))
            conn.commit()
            
    elif event['type'] == 'customer.subscription.deleted':
        sub_id = event['data']['object'].get('id')
        with sqlite3.connect(DATABASE_FILE) as conn:
            conn.execute("UPDATE system_operators SET tier_access = 'FREE_TIER' WHERE stripe_subscription_id = ?", (sub_id,))
            conn.commit()

    return Response(status=200)

