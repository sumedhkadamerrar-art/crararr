@app.route('/v1/auth/session', methods=['POST'])
def handle_auth_session():
    email = (request.json or {}).get("email")
    if not email:
        return jsonify({'error': 'Missing identification vector'}), 400
        
    with sqlite3.connect(DATABASE_FILE) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT tier_access FROM system_operators WHERE email = ?", (email,))
        row = cursor.fetchone()
        if row:
            return jsonify({'status': 'exists', 'tier': row[0]})
        
        cursor.execute("INSERT INTO system_operators (email, tier_access) VALUES (?, 'FREE_TIER')", (email,))
        conn.commit()
        return jsonify({'status': 'provisioned', 'tier': 'FREE_TIER'})

@app.route('/v1/intelligence/chat', methods=['POST'])
def handle_chat_inference():
    data = request.json or {}
    user_query = data.get("message", "")
    operator_email = data.get("email", "anonymous@local")

    # Enforce strict system routing boundary protections
    is_allowed, is_pro = check_rate_limits(operator_email)
    if not is_allowed:
        return jsonify({'error': 'Compute limits saturated for active matrix routing tier.'}), 429

    increment_usage(operator_email)

    def generate():
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        gen = engine.stream_tokens(user_query, is_pro)
        try:
            while True:
                try:
                    chunk = loop.run_until_complete(gen.__anext__())
                    yield chunk
                except StopAsyncIteration:
                    break
        finally:
            loop.close()

    return Response(generate(), mimetype='text/event-stream')

@app.route('/v1/billing/checkout', methods=['POST'])
def create_checkout_session():
    customer_email = (request.json or {}).get("email")
    with sqlite3.connect(DATABASE_FILE) as conn:
        cursor = conn.cursor()
        cursor.execute("SELECT stripe_customer_id FROM system_operators WHERE email = ?", (customer_email,))
        row = cursor.fetchone()
        customer_id = row[0] if row and row[0] else None

    try:
        checkout_kwargs = {
            'payment_method_types': ['card'],
            'line_items': [{'price': 'price_YOUR_PRODUCTION_PRICE_ID', 'quantity': 1}],
            'mode': 'subscription',
            'success_url': request.host_url,
            'cancel_url': request.host_url,
        }
        if customer_id:
            checkout_kwargs['customer'] = customer_id
        else:
            checkout_kwargs['customer_email'] = customer_email

        session = stripe.checkout.session.create(**checkout_kwargs)
        return jsonify({'id': session.id})
    except Exception as e:
        return jsonify({'error': str(e)}), 400

